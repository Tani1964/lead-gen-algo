# API Keys Configuration
# Copy this file to .env and fill in your actual API keys

# SerpAPI - https://serpapi.com/
# Sign up for free 100 searches/month
SERPAPI_KEY=your_serpapi_key_here

# Zenserp - https://zenserp.com/
# Free tier: 50 searches/month
ZENSERP_KEY=your_zenserp_key_here

# DataForSEO - https://dataforseo.com/
# Register and get credentials
DATAFORSEO_LOGIN=your_email@example.com
DATAFORSEO_PASSWORD=your_password_here

# ScraperAPI - https://scraperapi.com/
# Free tier: 1,000 requests/month
SCRAPERAPI_KEY=your_scraperapi_key_here

# Foursquare Places API - https://developer.foursquare.com/
# Free tier available
FOURSQUARE_API_KEY=your_foursquare_api_key_here

# Note: OpenStreetMap (Nominatim) doesn't require an API key
# but you must use a proper User-Agent (already configured in script)
